{
  "$defs": {
    "collection_role": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "minLength": 1,
          "type": "string"
        },
        "indexes": {
          "items": {
            "enum": [
              "primary",
              "document",
              "vector",
              "graph",
              "full_text",
              "columnar",
              "time_series",
              "geo"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "physical": {
          "$ref": "#/$defs/physical"
        },
        "role": {
          "enum": [
            "document_entity",
            "key_value",
            "event_log",
            "vector_memory",
            "cache",
            "audit",
            "graph",
            "analytics",
            "time_series"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "role",
        "domain",
        "indexes"
      ],
      "type": "object"
    },
    "consistency_domain": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "local_snapshot",
            "strong_cp",
            "eventual_ap"
          ],
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "mode"
      ],
      "type": "object"
    },
    "custom_profile": {
      "additionalProperties": false,
      "properties": {
        "compatible_roles": {
          "additionalProperties": false,
          "properties": {
            "add": {
              "items": {
                "enum": [
                  "document_entity",
                  "key_value",
                  "event_log",
                  "vector_memory",
                  "cache",
                  "audit",
                  "graph",
                  "analytics",
                  "time_series"
                ],
                "type": "string"
              },
              "type": "array"
            },
            "remove": {
              "items": {
                "enum": [
                  "document_entity",
                  "key_value",
                  "event_log",
                  "vector_memory",
                  "cache",
                  "audit",
                  "graph",
                  "analytics",
                  "time_series"
                ],
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "description": {
          "maxLength": 500,
          "type": "string"
        },
        "extends": {
          "minLength": 1,
          "type": "string"
        },
        "floors": {
          "additionalProperties": false,
          "properties": {
            "audit": {
              "type": "boolean"
            },
            "backup": {
              "type": "boolean"
            },
            "encryption_at_rest": {
              "type": "boolean"
            },
            "pitr": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "knobs": {
          "$ref": "#/$defs/profile_knob_overrides"
        }
      },
      "required": [
        "extends"
      ],
      "type": "object"
    },
    "defaults": {
      "additionalProperties": false,
      "properties": {
        "consistency_domain": {
          "minLength": 1,
          "type": "string"
        },
        "replication": {
          "enum": [
            "cp",
            "ap"
          ],
          "type": "string"
        }
      },
      "required": [
        "consistency_domain",
        "replication"
      ],
      "type": "object"
    },
    "deployment": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "embedded",
            "single_node",
            "cluster"
          ],
          "type": "string"
        },
        "storage_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "mode",
        "storage_path"
      ],
      "type": "object"
    },
    "extension_ref": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "stability": {
          "enum": [
            "stable",
            "experimental"
          ],
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "stability"
      ],
      "type": "object"
    },
    "guarantees": {
      "additionalProperties": false,
      "properties": {
        "audit": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ],
          "type": "object"
        },
        "backup": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "pitr": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled",
            "pitr"
          ],
          "type": "object"
        },
        "conflict_resolution": {
          "enum": [
            "none",
            "last_write_wins",
            "vector_clock",
            "crdt",
            "custom"
          ],
          "type": "string"
        },
        "encryption": {
          "additionalProperties": false,
          "properties": {
            "at_rest": {
              "type": "boolean"
            }
          },
          "required": [
            "at_rest"
          ],
          "type": "object"
        },
        "sensitive_data": {
          "type": "boolean"
        },
        "strict_cross_domain_transactions": {
          "type": "boolean"
        },
        "write_ack": {
          "enum": [
            "local",
            "quorum",
            "all"
          ],
          "type": "string"
        }
      },
      "required": [
        "write_ack",
        "conflict_resolution",
        "backup",
        "encryption",
        "audit",
        "sensitive_data",
        "strict_cross_domain_transactions"
      ],
      "type": "object"
    },
    "physical": {
      "additionalProperties": false,
      "description": "How provisioning builds the collection. Every property is optional and applies to the kinds its description names (PHYSICAL_FIELD_NOT_APPLICABLE otherwise).",
      "properties": {
        "chunk_millis": {
          "description": "time_series: chunk width; defaults to the time_series.default_chunk_millis knob.",
          "maximum": 2678400000,
          "minimum": 1000,
          "type": "integer"
        },
        "collection_id": {
          "description": "document, vector: a pinned collection id; unpinned ids are allocated at creation.",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "columns": {
          "description": "table: typed columns; empty means a schemaless row table.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "description": "Column name.",
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "nullable": {
                "description": "Default false.",
                "type": "boolean"
              },
              "type": {
                "description": "Value type.",
                "enum": [
                  "int",
                  "float",
                  "str",
                  "bool",
                  "bytes"
                ],
                "type": "string"
              }
            },
            "required": [
              "name",
              "type"
            ],
            "type": "object"
          },
          "maxItems": 256,
          "type": "array"
        },
        "dim": {
          "description": "vector: the dimension, fixed at creation; required.",
          "maximum": 65536,
          "minimum": 1,
          "type": "integer"
        },
        "document_indexes": {
          "description": "document: secondary indexes; required by the document index kind.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "description": "Index id; defaults to position + 1.",
                "maximum": 4294967295,
                "minimum": 0,
                "type": "integer"
              },
              "path": {
                "description": "Dotted document path.",
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "path"
            ],
            "type": "object"
          },
          "maxItems": 64,
          "type": "array"
        },
        "fields": {
          "description": "document: SQL-visible fields; empty means one field id holding the document id.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "description": "Field name.",
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "path": {
                "description": "Dotted document path, or $id for the document id (type bytes).",
                "minLength": 1,
                "type": "string"
              },
              "type": {
                "description": "Value type.",
                "enum": [
                  "int",
                  "float",
                  "str",
                  "bool",
                  "bytes"
                ],
                "type": "string"
              }
            },
            "required": [
              "name",
              "path",
              "type"
            ],
            "type": "object"
          },
          "maxItems": 256,
          "type": "array"
        },
        "full_text": {
          "description": "document: full-text indexes, named <collection>_<path>_fts unless name is set; required by the full_text index kind.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "language": {
                "description": "Tokenizer language; only simple in this build.",
                "enum": [
                  "simple"
                ],
                "type": "string"
              },
              "name": {
                "description": "Index name.",
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "path": {
                "description": "Dotted document path of the text.",
                "minLength": 1,
                "type": "string"
              },
              "refresh_lag_target": {
                "description": "Refresh lag target (default 1).",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "path"
            ],
            "type": "object"
          },
          "maxItems": 16,
          "type": "array"
        },
        "geo": {
          "description": "document: geo indexes, named <collection>_<path>_geo unless name is set; required by the geo index kind.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "description": "Index name.",
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "path": {
                "description": "Dotted document path of the point.",
                "minLength": 1,
                "type": "string"
              },
              "precision": {
                "description": "Geohash precision (default 6).",
                "maximum": 12,
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "path"
            ],
            "type": "object"
          },
          "maxItems": 16,
          "type": "array"
        },
        "graph_id": {
          "description": "graph: a pinned graph id; unpinned ids are allocated at creation.",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "hnsw": {
          "additionalProperties": false,
          "description": "vector: HNSW parameters (default 16/200/48); ef_construction must be at least m.",
          "properties": {
            "ef_construction": {
              "maximum": 4294967295,
              "minimum": 1,
              "type": "integer"
            },
            "ef_search": {
              "maximum": 4294967295,
              "minimum": 1,
              "type": "integer"
            },
            "m": {
              "maximum": 255,
              "minimum": 1,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "keep_history": {
          "description": "table: keep history rows; defaults to the history.keep_history knob.",
          "type": "boolean"
        },
        "kind": {
          "description": "All kinds: the runtime object. Defaults to the first kind the role allows.",
          "enum": [
            "document",
            "table",
            "vector",
            "time_series",
            "graph"
          ],
          "type": "string"
        },
        "layout": {
          "description": "table: physical layout; defaults to columnar for analytics and to the database layout otherwise.",
          "enum": [
            "row",
            "columnar"
          ],
          "type": "string"
        },
        "max_future_skew_millis": {
          "description": "time_series: how far ahead of the server clock a point's timestamp may lie; later points are refused. Defaults to 300000 when left out; null means no bound, as for series created before the bound existed. 9223372036854775807 is read as null, and no bound is always written as null. Fixed at creation.",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "metric": {
          "description": "vector: distance metric (default cosine).",
          "enum": [
            "cosine",
            "l2"
          ],
          "type": "string"
        },
        "primary_key": {
          "description": "table: the primary key column; required when columns are given.",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "retention_millis": {
          "description": "time_series: retention, at least one chunk; defaults to the time_series.default_retention_millis knob.",
          "minimum": 1,
          "type": "integer"
        },
        "system_versioning": {
          "description": "table: keep system-versioned history in <table>_history (typed row tables); defaults to the history.system_versioning knob.",
          "type": "boolean"
        },
        "table_indexes": {
          "description": "table: B-tree indexes of a row table; required by the document index kind.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "column": {
                "description": "Indexed column.",
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "expression": {
                "description": "What the index keys on (default column); lower_ascii needs a str column.",
                "enum": [
                  "column",
                  "lower_ascii"
                ],
                "type": "string"
              },
              "id": {
                "description": "Index id; defaults to position + 1.",
                "maximum": 4294967295,
                "minimum": 0,
                "type": "integer"
              },
              "include": {
                "description": "Covered columns.",
                "items": {
                  "description": "Column name.",
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "column"
            ],
            "type": "object"
          },
          "maxItems": 64,
          "type": "array"
        }
      },
      "type": "object"
    },
    "profile_knob_overrides": {
      "additionalProperties": false,
      "properties": {
        "cache": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "description": "Whether the read cache is on.",
              "type": "boolean"
            },
            "max_entries": {
              "description": "Maximum number of cached values.",
              "maximum": 1048576,
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "compression": {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "description": "Value compression; anything but none turns on value framing (schema_version 2). Switching lz4 and zstd later is a retune.",
              "enum": [
                "none",
                "lz4",
                "zstd"
              ],
              "type": "string"
            },
            "min_bytes": {
              "description": "Values shorter than this are stored in a raw frame.",
              "maximum": 1048576,
              "minimum": 64,
              "type": "integer"
            },
            "zstd_level": {
              "description": "zstd compression level; only used with algorithm zstd.",
              "maximum": 19,
              "minimum": 1,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "consistency": {
          "additionalProperties": false,
          "properties": {
            "default_domain": {
              "description": "Consistency domain of the spec that init --guided --override writes. Guided init without --override and templates use the product's domain.",
              "enum": [
                "local_snapshot",
                "strong_cp",
                "eventual_ap"
              ],
              "type": "string"
            }
          },
          "type": "object"
        },
        "durability": {
          "additionalProperties": false,
          "properties": {
            "commit": {
              "description": "Commit protocol of every redb write transaction.",
              "enum": [
                "immediate",
                "two_phase"
              ],
              "type": "string"
            },
            "group_commit_window_ms": {
              "description": "How long single-node commits wait to be batched together.",
              "maximum": 50,
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "history": {
          "additionalProperties": false,
          "properties": {
            "keep_history": {
              "description": "Whether system-versioned history is kept.",
              "type": "boolean"
            },
            "system_versioning": {
              "description": "Whether provisioned typed tables keep system-versioned history.",
              "enum": [
                "off",
                "typed_tables"
              ],
              "type": "string"
            }
          },
          "type": "object"
        },
        "limits": {
          "additionalProperties": false,
          "properties": {
            "max_batch_ops": {
              "description": "Largest accepted write batch; only unlimited is accepted until the single write pipeline lands.",
              "oneOf": [
                {
                  "const": "unlimited"
                },
                {
                  "maximum": 1000000,
                  "minimum": 1,
                  "type": "integer"
                }
              ]
            },
            "max_value_bytes": {
              "description": "Largest accepted user value; only unlimited is accepted until the single write pipeline lands.",
              "oneOf": [
                {
                  "const": "unlimited"
                },
                {
                  "maximum": 67108864,
                  "minimum": 1024,
                  "type": "integer"
                }
              ]
            }
          },
          "type": "object"
        },
        "query": {
          "additionalProperties": false,
          "properties": {
            "batch_rows": {
              "description": "Rows per record batch.",
              "maximum": 1048576,
              "minimum": 1,
              "type": "integer"
            },
            "max_concurrent_queries": {
              "description": "Query permits; auto is four per available thread.",
              "oneOf": [
                {
                  "const": "auto"
                },
                {
                  "maximum": 4096,
                  "minimum": 1,
                  "type": "integer"
                }
              ]
            },
            "max_sql_bytes": {
              "description": "Maximum SQL text size.",
              "maximum": 16777216,
              "minimum": 1024,
              "type": "integer"
            },
            "max_statements": {
              "description": "Maximum statements per SQL request.",
              "maximum": 1024,
              "minimum": 1,
              "type": "integer"
            },
            "max_values_rows": {
              "description": "Maximum rows in one VALUES list.",
              "maximum": 1000000,
              "minimum": 1,
              "type": "integer"
            },
            "memory_limit_bytes": {
              "description": "Memory pool of one SQL query.",
              "maximum": 68719476736,
              "minimum": 67108864,
              "type": "integer"
            },
            "parser_recursion_limit": {
              "description": "SQL parser recursion depth; SELECTs that DataFusion plans stay capped at DataFusion's own limit of 50.",
              "maximum": 1024,
              "minimum": 16,
              "type": "integer"
            },
            "queue_timeout_ms": {
              "description": "How long a query waits for a permit before it is rejected.",
              "maximum": 60000,
              "minimum": 1,
              "type": "integer"
            },
            "spill_limit_bytes": {
              "description": "Maximum spill-to-disk size of one SQL query.",
              "maximum": 1099511627776,
              "minimum": 0,
              "type": "integer"
            },
            "target_partitions": {
              "description": "DataFusion partitions; auto is the storage profile default.",
              "oneOf": [
                {
                  "const": "auto"
                },
                {
                  "maximum": 256,
                  "minimum": 1,
                  "type": "integer"
                }
              ]
            },
            "timeout_ms": {
              "description": "SQL execution timeout.",
              "maximum": 3600000,
              "minimum": 100,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "storage": {
          "additionalProperties": false,
          "properties": {
            "layout": {
              "description": "Default table layout of the database.",
              "enum": [
                "row",
                "columnar"
              ],
              "type": "string"
            },
            "medium": {
              "description": "Whether data lives in a durable redb file or only in memory.",
              "enum": [
                "durable",
                "volatile"
              ],
              "type": "string"
            }
          },
          "type": "object"
        },
        "time_series": {
          "additionalProperties": false,
          "properties": {
            "default_chunk_millis": {
              "description": "Default chunk width of time series.",
              "maximum": 2678400000,
              "minimum": 1000,
              "type": "integer"
            },
            "default_retention_millis": {
              "description": "Default retention of time series; null keeps data forever and a value must be at least one chunk.",
              "maximum": 9223372036854775807,
              "minimum": 1,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "provisioning": {
      "additionalProperties": false,
      "properties": {
        "unmanaged": {
          "description": "What a plan does with catalog objects the spec does not declare (default report).",
          "enum": [
            "ignore",
            "report",
            "fail"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "security": {
      "additionalProperties": false,
      "description": "Roles and principals provisioning manages; others are never changed. The role admin and the principals admin and root are reserved.",
      "properties": {
        "principals": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "principal": {
                "description": "Principal name; defaults to the user.",
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "roles": {
                "items": {
                  "description": "A role of security.roles.",
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "user": {
                "description": "Login user name.",
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "user",
              "roles"
            ],
            "type": "object"
          },
          "maxItems": 4096,
          "type": "array"
        },
        "roles": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "grants": {
                "items": {
                  "additionalProperties": false,
                  "description": "Exactly one of object or resource.",
                  "oneOf": [
                    {
                      "required": [
                        "object"
                      ]
                    },
                    {
                      "required": [
                        "resource"
                      ]
                    }
                  ],
                  "properties": {
                    "object": {
                      "description": "A collection, or a full-text, geo or history object of the spec.",
                      "maxLength": 128,
                      "minLength": 1,
                      "type": "string"
                    },
                    "permissions": {
                      "items": {
                        "description": "Permission.",
                        "enum": [
                          "read",
                          "write",
                          "admin"
                        ],
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "resource": {
                      "description": "The whole database.",
                      "enum": [
                        "database"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "permissions"
                  ],
                  "type": "object"
                },
                "maxItems": 1024,
                "type": "array"
              },
              "name": {
                "description": "Role name, ^[a-z][a-z0-9_]{0,63}$.",
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "name",
              "grants"
            ],
            "type": "object"
          },
          "maxItems": 256,
          "type": "array"
        }
      },
      "type": "object"
    },
    "string_map": {
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "minLength": 1
      },
      "type": "object"
    },
    "topology": {
