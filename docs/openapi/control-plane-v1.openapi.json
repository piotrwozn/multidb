{
  "openapi": "3.1.0",
  "info": {
    "title": "MultiDB Control Plane API",
    "version": "1.0.0",
    "description": "Public HTTP contract for the MultiDB Control Plane API v1."
  },
  "x-multidb-api-version": 1,
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Local Docker or multidb serve runtime"
    }
  ],
  "tags": [
    { "name": "Auth" },
    { "name": "Status" },
    { "name": "Catalog" },
    { "name": "SQL" },
    { "name": "Data" },
    { "name": "Builder" },
    { "name": "Admin" },
    { "name": "Advice" },
    { "name": "Provisioning" },
    { "name": "Contract" }
  ],
  "paths": {
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "tags": ["Contract"],
        "summary": "Return the Control Plane OpenAPI v1 document.",
        "security": [],
        "x-multidb-stability": "stable",
        "responses": {
          "200": {
            "description": "OpenAPI document",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": ["Status"],
        "summary": "Liveness probe.",
        "security": [],
        "x-multidb-stability": "stable",
        "responses": {
          "200": {
            "description": "Liveness response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "getReady",
        "tags": ["Status"],
        "summary": "Readiness probe.",
        "security": [],
        "x-multidb-stability": "stable",
        "responses": {
          "200": {
            "description": "Ready response"
          },
          "503": {
            "description": "Runtime is not ready"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "tags": ["Auth"],
        "summary": "Create an admin session token.",
        "security": [],
        "x-multidb-stability": "stable",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/LoginEnvelope" },
          "401": { "$ref": "#/components/responses/ErrorEnvelope" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "tags": ["Auth"],
        "summary": "Revoke the current session token.",
        "security": [{ "BearerAuth": [] }],
        "x-multidb-stability": "stable",
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObjectEnvelope" },
          "401": { "$ref": "#/components/responses/ErrorEnvelope" }
        }
      }
    },
    "/auth/change-password": {
      "post": {
        "operationId": "changePassword",
        "tags": ["Auth"],
        "summary": "Change the durable admin password.",
        "security": [{ "BearerAuth": [] }],
        "x-multidb-stability": "stable",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChangePasswordRequest" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObjectEnvelope" },
          "401": { "$ref": "#/components/responses/ErrorEnvelope" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "getAuthMe",
        "tags": ["Auth"],
        "summary": "Return the authenticated admin principal.",
        "security": [{ "BearerAuth": [] }],
        "x-multidb-stability": "stable",
        "responses": {
          "200": { "$ref": "#/components/responses/AuthMeEnvelope" },
          "401": { "$ref": "#/components/responses/ErrorEnvelope" }
        }
      }
    },
    "/status": {
      "get": {
        "operationId": "getStatus",
        "tags": ["Status"],
        "summary": "Return runtime status.",
        "security": [{ "BearerAuth": [] }],
        "x-multidb-stability": "stable",
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObjectEnvelope" }
        }
      }
    },
    "/metrics": {
      "get": {
        "operationId": "getMetrics",
        "tags": ["Status"],
        "summary": "Return raw text metrics.",
        "security": [{ "BearerAuth": [] }],
        "x-multidb-stability": "preview",
        "responses": {
          "200": {
            "description": "Raw metrics text",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ErrorEnvelope" }
        }
      }
    },
    "/catalog": { "get": { "$ref": "#/components/pathItems/getCatalog" } },
    "/sql": {
      "post": {
        "operationId": "executeSql",
        "tags": ["SQL"],
        "summary": "Execute a SQL statement.",
        "security": [{ "BearerAuth": [] }],
        "x-multidb-stability": "stable",
        "requestBody": { "$ref": "#/components/requestBodies/SqlRequest" },
        "responses": { "200": { "$ref": "#/components/responses/JsonObjectEnvelope" } }
      }
    },
    "/data/tables/{name}/rows": {
      "get": {
        "operationId": "listTableRows",
        "tags": ["Data"],
        "summary": "List table rows.",
        "security": [{ "BearerAuth": [] }],
        "x-multidb-stability": "stable",
        "parameters": [
          { "$ref": "#/components/parameters/NamePath" },
          { "$ref": "#/components/parameters/OffsetQuery" },
          { "$ref": "#/components/parameters/LimitQuery" }
        ],
        "responses": { "200": { "$ref": "#/components/responses/JsonObjectEnvelope" } }
      },
      "post": {
        "operationId": "insertTableRow",
        "tags": ["Data"],
        "summary": "Insert a table row.",
        "security": [{ "BearerAuth": [] }],
        "x-multidb-stability": "stable",
        "parameters": [{ "$ref": "#/components/parameters/NamePath" }],
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": { "200": { "$ref": "#/components/responses/JsonObjectEnvelope" } }
      },
      "put": {
        "operationId": "updateTableRow",
        "tags": ["Data"],
        "summary": "Update a table row by primary key.",
        "security": [{ "BearerAuth": [] }],
        "x-multidb-stability": "stable",
        "parameters": [{ "$ref": "#/components/parameters/NamePath" }],
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": { "200": { "$ref": "#/components/responses/JsonObjectEnvelope" } }
      },
      "delete": {
        "operationId": "deleteTableRow",
        "tags": ["Data"],
        "summary": "Delete a table row after exact confirmation.",
        "security": [{ "BearerAuth": [] }],
        "x-multidb-stability": "stable",
        "parameters": [{ "$ref": "#/components/parameters/NamePath" }],
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObjectEnvelope" },
          "422": { "$ref": "#/components/responses/ErrorEnvelope" }
        }
      }
    },
    "/data/collections/{name}/documents": {
      "get": {
        "operationId": "listDocuments",
        "tags": ["Data"],
        "summary": "List collection documents.",
        "security": [{ "BearerAuth": [] }],
        "x-multidb-stability": "stable",
        "parameters": [
          { "$ref": "#/components/parameters/NamePath" },
          { "$ref": "#/components/parameters/OffsetQuery" },
          { "$ref": "#/components/parameters/LimitQuery" }
        ],
        "responses": { "200": { "$ref": "#/components/responses/JsonObjectEnvelope" } }
      },
      "post": {
        "operationId": "createDocument",
        "tags": ["Data"],
        "summary": "Create a collection document.",
        "security": [{ "BearerAuth": [] }],
        "x-multidb-stability": "stable",
        "parameters": [{ "$ref": "#/components/parameters/NamePath" }],
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": { "200": { "$ref": "#/components/responses/JsonObjectEnvelope" } }
      }
    },
    "/data/collections/{name}/documents/{id}": {
      "put": {
        "operationId": "updateDocument",
        "tags": ["Data"],
        "summary": "Update a collection document.",
        "security": [{ "BearerAuth": [] }],
        "x-multidb-stability": "stable",
        "parameters": [
          { "$ref": "#/components/parameters/NamePath" },
          { "$ref": "#/components/parameters/IdPath" }
        ],
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": { "200": { "$ref": "#/components/responses/JsonObjectEnvelope" } }
      },
      "delete": {
        "operationId": "deleteDocument",
        "tags": ["Data"],
        "summary": "Delete a collection document after exact confirmation.",
        "security": [{ "BearerAuth": [] }],
        "x-multidb-stability": "stable",
        "parameters": [
          { "$ref": "#/components/parameters/NamePath" },
          { "$ref": "#/components/parameters/IdPath" }
        ],
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObjectEnvelope" },
          "422": { "$ref": "#/components/responses/ErrorEnvelope" }
        }
      }
    },
    "/data/vectors/{name}/vectors": { "post": { "$ref": "#/components/pathItems/insertVector" } },
    "/data/vectors/{name}/search": { "post": { "$ref": "#/components/pathItems/searchVector" } },
    "/data/time-series/{name}/points": {
      "get": {
        "operationId": "listTimeSeriesPoints",
        "tags": ["Data"],
        "summary": "Read a time-series range.",
        "security": [{ "BearerAuth": [] }],
        "x-multidb-stability": "stable",
        "parameters": [
          { "$ref": "#/components/parameters/NamePath" },
          { "name": "series", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "start", "in": "query", "required": true, "schema": { "type": "integer", "format": "int64" } },
          { "name": "end", "in": "query", "required": true, "schema": { "type": "integer", "format": "int64" } }
        ],
        "responses": { "200": { "$ref": "#/components/responses/JsonObjectEnvelope" } }
      },
      "post": {
        "operationId": "insertTimeSeriesPoint",
        "tags": ["Data"],
        "summary": "Insert a time-series point.",
        "security": [{ "BearerAuth": [] }],
        "x-multidb-stability": "stable",
        "parameters": [{ "$ref": "#/components/parameters/NamePath" }],
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": { "200": { "$ref": "#/components/responses/JsonObjectEnvelope" } }
      }
    },
    "/builder/table": { "post": { "$ref": "#/components/pathItems/createTable" } },
    "/builder/collection": { "post": { "$ref": "#/components/pathItems/createCollection" } },
    "/builder/vector": { "post": { "$ref": "#/components/pathItems/createVector" } },
    "/builder/time-series": { "post": { "$ref": "#/components/pathItems/createTimeSeries" } },
    "/builder/full-text": { "post": { "$ref": "#/components/pathItems/createFullText" } },
    "/builder/geo": { "post": { "$ref": "#/components/pathItems/createGeoIndex" } },
    "/builder/graph": { "post": { "$ref": "#/components/pathItems/createGraph" } },
    "/security": {
      "get": {
        "operationId": "getSecurity",
        "tags": ["Admin"],
        "summary": "Read RBAC state.",
        "security": [{ "BearerAuth": [] }],
        "x-multidb-stability": "stable",
        "responses": { "200": { "$ref": "#/components/responses/JsonObjectEnvelope" } }
      },
      "post": {
        "operationId": "updateSecurity",
        "tags": ["Admin"],
        "summary": "Update RBAC state.",
        "security": [{ "BearerAuth": [] }],
        "x-multidb-stability": "stable",
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": {
          "200": { "$ref": "#/components/responses/JsonObjectEnvelope" },
          "403": { "$ref": "#/components/responses/ErrorEnvelope" }
        }
      }
    },
    "/audit": { "get": { "$ref": "#/components/pathItems/getAudit" } },
    "/config": { "get": { "$ref": "#/components/pathItems/getConfig" } },
    "/config/validate": { "post": { "$ref": "#/components/pathItems/validateConfig" } },
    "/config/plan": { "post": { "$ref": "#/components/pathItems/planConfig" } },
    "/config/apply": { "post": { "$ref": "#/components/pathItems/applyConfig" } },
    "/config/live": { "get": { "$ref": "#/components/pathItems/getLiveConfig" } },
    "/provision/state": { "get": { "$ref": "#/components/pathItems/getProvisionState" } },
    "/provision/plan": { "post": { "$ref": "#/components/pathItems/planProvision" } },
    "/provision/apply": { "post": { "$ref": "#/components/pathItems/applyProvision" } },
    "/provision/drift": { "post": { "$ref": "#/components/pathItems/checkProvisionDrift" } },
    "/profiles": { "get": { "$ref": "#/components/pathItems/getProfiles" } },
    "/roles": { "get": { "$ref": "#/components/pathItems/getRoles" } },
    "/domains": { "get": { "$ref": "#/components/pathItems/getDomains" } },
    "/extensions": { "get": { "$ref": "#/components/pathItems/getExtensions" } },
    "/advice": { "get": { "$ref": "#/components/pathItems/getAdvice" } },
    "/advice/plan": { "post": { "$ref": "#/components/pathItems/planAdvice" } },
    "/advice/decision": { "post": { "$ref": "#/components/pathItems/recordAdviceDecision" } },
    "/studio": { "get": { "$ref": "#/components/pathItems/getStudioManifest" } }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "JsonValue": true,
      "JsonObject": {
        "type": "object",
        "additionalProperties": true
      },
      "ApiError": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "SuccessEnvelope": {
        "type": "object",
        "required": ["ok", "data"],
        "properties": {
          "ok": { "type": "boolean", "const": true },
          "data": { "$ref": "#/components/schemas/JsonValue" }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["ok", "error"],
        "properties": {
          "ok": { "type": "boolean", "const": false },
          "error": { "$ref": "#/components/schemas/ApiError" }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": ["ok", "status"],
        "properties": {
          "ok": { "type": "boolean" },
          "status": { "type": "string" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string", "format": "password" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": ["token", "expires_at", "expires_at_millis", "principal", "roles"],
        "properties": {
          "token": { "type": "string" },
          "expires_at": { "type": "string" },
          "expires_at_millis": { "type": "integer", "format": "uint64" },
          "principal": { "type": "string" },
          "roles": { "type": "array", "items": { "type": "string" } }
        }
      },
      "AuthMeResponse": {
        "type": "object",
        "required": ["principal", "roles", "system_admin", "database_admin", "insecure_local_admin"],
        "properties": {
          "principal": { "type": "string" },
          "roles": { "type": "array", "items": { "type": "string" } },
          "system_admin": { "type": "boolean" },
          "database_admin": { "type": "boolean" },
          "insecure_local_admin": { "type": "boolean" }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": ["current_password", "new_password"],
        "properties": {
          "current_password": { "type": "string", "format": "password" },
          "new_password": { "type": "string", "format": "password" }
        }
      },
      "ErrorEnvelopeWithData": {
        "type": "object",
        "description": "Enveloped error. For provisioning errors `data` carries the plan, the apply report, the validation report or the confirmed and current plan ids, when there is one.",
        "required": ["ok", "error"],
        "properties": {
          "ok": { "type": "boolean", "const": false },
          "error": { "$ref": "#/components/schemas/ApiError" },
          "data": { "$ref": "#/components/schemas/JsonValue" }
        }
      },
      "ProvisionOptions": {
        "type": "object",
        "description": "Per-run provisioning options; part of the prov_ plan id, so an apply must repeat the options of the plan it confirms.",
        "additionalProperties": false,
        "properties": {
          "allow_weakening": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "allow_destructive": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "allow_format_upgrade": { "type": "boolean" },
          "unmanaged": { "type": "string", "enum": ["ignore", "report", "fail"] }
        }
      },
      "ProvisionRequest": {
        "type": "object",
        "required": ["spec"],
        "additionalProperties": false,
        "properties": {
          "spec": {
            "$ref": "#/components/schemas/JsonObject",
            "description": "A DatabaseSpec, version 1 or 2.",
            "x-multidb-json-schema": "https://multidb.dev/schemas/database-spec-v2.schema.json"
          },
          "options": { "$ref": "#/components/schemas/ProvisionOptions" }
        }
      },
      "ProvisionApplyRequest": {
        "type": "object",
        "required": ["spec"],
        "additionalProperties": false,
        "properties": {
          "spec": {
            "$ref": "#/components/schemas/JsonObject",
            "description": "A DatabaseSpec, version 1 or 2.",
            "x-multidb-json-schema": "https://multidb.dev/schemas/database-spec-v2.schema.json"
          },
          "options": { "$ref": "#/components/schemas/ProvisionOptions" },
          "confirm": {
            "type": "string",
            "description": "The prov_ id of the reviewed plan. The server recomputes the plan and applies it only when the id is still current; without it the plan is returned with 422 confirmation_required (a noop needs no confirmation)."
          }
        }
      },
      "ProvisionPlan": {
        "type": "object",
        "description": "A provisioning plan of the served database (see docs/provisioning.md).",
        "required": ["plan_format", "plan_id", "surface", "target", "spec_digest", "live_fingerprint", "resolved_profile", "validation", "issues", "objects", "guarantees", "drift", "steps", "spec_migration", "outcome", "required_flags", "auto_approvable", "impact", "rollback", "required_confirmation"],
        "properties": {
          "plan_format": { "type": "integer" },
          "plan_id": { "type": "string" },
          "surface": { "type": "string" },
          "outcome": { "type": "string", "enum": ["noop", "ready", "needs_flags", "blocked"] },
          "required_flags": { "type": "array", "items": { "type": "string" } },
          "auto_approvable": { "type": "boolean" },
          "required_confirmation": { "type": ["string", "null"] }
        }
      },
      "ProvisionApplyReport": {
        "type": "object",
        "description": "What an apply did.",
        "required": ["status", "check", "plan_id", "applied_steps", "failed_step", "record", "warnings", "session_pending_restart"],
        "properties": {
          "status": { "type": "string", "enum": ["applied", "noop", "rejected", "blocked", "plan_changed", "partially_applied"] },
          "plan_id": { "type": "string" },
          "failed_step": { "type": ["string", "null"] },
          "session_pending_restart": { "type": "boolean" }
        }
      },
      "DriftReport": {
        "type": "object",
        "description": "How the served database differs from a spec.",
        "required": ["in_sync", "items"],
        "properties": {
          "in_sync": { "type": "boolean" },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/JsonObject" } }
        }
      },
      "ProvisionState": {
        "type": "object",
        "required": ["provisioned", "record", "history", "manifest", "live_fingerprint", "spec_mode"],
        "properties": {
          "provisioned": { "type": "boolean" },
          "history": { "type": "array", "items": { "$ref": "#/components/schemas/JsonObject" } },
          "live_fingerprint": { "type": "string" }
        }
      },
      "LiveConfig": {
        "type": "object",
        "required": ["spec", "source", "notes", "live_fingerprint"],
        "properties": {
          "spec": { "$ref": "#/components/schemas/JsonObject" },
          "source": { "type": "string", "enum": ["applied_record", "inferred"] },
          "notes": { "type": "array", "items": { "type": "string" } },
          "live_fingerprint": { "type": "string" }
        }
      },
      "ProvisionPlanEnvelope": {
        "type": "object",
        "required": ["ok", "data"],
        "properties": {
          "ok": { "type": "boolean", "const": true },
          "data": { "$ref": "#/components/schemas/ProvisionPlan" }
        }
      },
      "ProvisionApplyReportEnvelope": {
        "type": "object",
        "required": ["ok", "data"],
        "properties": {
          "ok": { "type": "boolean", "const": true },
          "data": { "$ref": "#/components/schemas/ProvisionApplyReport" }
        }
      },
      "DriftReportEnvelope": {
        "type": "object",
        "required": ["ok", "data"],
        "properties": {
          "ok": { "type": "boolean", "const": true },
          "data": { "$ref": "#/components/schemas/DriftReport" }
        }
      },
      "ProvisionStateEnvelope": {
        "type": "object",
        "required": ["ok", "data"],
        "properties": {
          "ok": { "type": "boolean", "const": true },
          "data": { "$ref": "#/components/schemas/ProvisionState" }
        }
      },
      "LiveConfigEnvelope": {
        "type": "object",
        "required": ["ok", "data"],
        "properties": {
          "ok": { "type": "boolean", "const": true },
          "data": { "$ref": "#/components/schemas/LiveConfig" }
        }
      }
    },
    "examples": {
      "SuccessEnvelope": {
        "summary": "Successful enveloped response",
        "value": { "ok": true, "data": {} }
      },
      "ErrorEnvelope": {
        "summary": "Failed enveloped response",
        "value": { "ok": false, "error": { "code": "unauthorized", "message": "unauthorized" } }
      }
    },
    "parameters": {
      "NamePath": { "name": "name", "in": "path", "required": true, "schema": { "type": "string" } },
      "IdPath": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
      "OffsetQuery": { "name": "offset", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "default": 0 } },
      "LimitQuery": { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 100 } }
    },
    "requestBodies": {
      "JsonObject": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JsonObject" } } }
      },
      "SqlRequest": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["sql"],
              "properties": { "sql": { "type": "string" } }
            }
          }
        }
      },
      "ProvisionRequest": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProvisionRequest" } } }
      },
      "ProvisionApplyRequest": {
        "required": true,
