      "getConfig": { "operationId": "getConfig", "tags": ["Admin"], "summary": "Return current DatabaseSpec.", "description": "Legacy: a version 1 spec built from the database configuration only (no collections). GET /config/live describes the served database as a spec.", "security": [{ "BearerAuth": [] }], "x-multidb-stability": "stable", "responses": { "200": { "$ref": "#/components/responses/JsonObjectEnvelope" } } },
      "validateConfig": { "operationId": "validateConfig", "tags": ["Admin"], "summary": "Validate a DatabaseSpec.", "security": [{ "BearerAuth": [] }], "x-multidb-stability": "stable", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "$ref": "#/components/responses/JsonObjectEnvelope" }, "422": { "$ref": "#/components/responses/JsonObjectEnvelope" } } },
      "planConfig": { "operationId": "planConfig", "tags": ["Admin"], "summary": "Plan a DatabaseSpec change.", "security": [{ "BearerAuth": [] }], "x-multidb-stability": "stable", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "$ref": "#/components/responses/JsonObjectEnvelope" }, "422": { "$ref": "#/components/responses/JsonObjectOrErrorEnvelope" } } },
      "applyConfig": { "operationId": "applyConfig", "tags": ["Admin"], "summary": "Confirm and audit a planned config change.", "description": "Audit-only (data_mutated: false). The body is {plan, confirm}, a plan the client computed (audited as plan_source: client), or {current, desired, confirm}, from which the server recomputes the plan as POST /config/plan does (audited as plan_source: recomputed). Provisioning is POST /provision/apply.", "security": [{ "BearerAuth": [] }], "x-multidb-stability": "stable", "requestBody": { "$ref": "#/components/requestBodies/JsonObject" }, "responses": { "200": { "$ref": "#/components/responses/JsonObjectEnvelope" }, "422": { "$ref": "#/components/responses/JsonObjectOrErrorEnvelope" } } },
      "getLiveConfig": { "operationId": "getLiveConfig", "tags": ["Provisioning"], "summary": "Return the served database as a DatabaseSpec.", "description": "The spec the last provisioning apply recorded (source applied_record), or a version 2 spec inferred from the catalog, profile manifest, RBAC and audit state (source inferred), with notes and the live fingerprint. Requires System:Admin.", "security": [{ "BearerAuth": [] }], "x-multidb-stability": "preview", "responses": { "200": { "$ref": "#/components/responses/LiveConfigEnvelope" }, "403": { "$ref": "#/components/responses/ErrorEnvelope" }, "422": { "$ref": "#/components/responses/ProvisionErrorEnvelope" }, "500": { "$ref": "#/components/responses/ProvisionErrorEnvelope" } } },
      "getProvisionState": { "operationId": "getProvisionState", "tags": ["Provisioning"], "summary": "Return what provisioning manages in the served database.", "description": "The provision record, its history, the profile manifest, the live fingerprint and, when multidb serve runs in spec mode, the spec digest and MULTIDB_SPEC_APPLY mode. Requires System:Admin.", "security": [{ "BearerAuth": [] }], "x-multidb-stability": "preview", "responses": { "200": { "$ref": "#/components/responses/ProvisionStateEnvelope" }, "403": { "$ref": "#/components/responses/ErrorEnvelope" }, "422": { "$ref": "#/components/responses/ProvisionErrorEnvelope" }, "500": { "$ref": "#/components/responses/ProvisionErrorEnvelope" } } },
      "planProvision": { "operationId": "planProvision", "tags": ["Provisioning"], "summary": "Plan a spec against the served database.", "description": "A dry run on the control_plane surface; nothing is written. Ready, noop and needs_flags plans are 200; a blocked plan or an invalid spec is 422 with the plan in data (codes invalid_spec, provision_blocked, audit_required, rbac_self_lockout); an unsupported spec version is 422 invalid_spec_version. Requires System:Admin.", "security": [{ "BearerAuth": [] }], "x-multidb-stability": "preview", "requestBody": { "$ref": "#/components/requestBodies/ProvisionRequest" }, "responses": { "200": { "$ref": "#/components/responses/ProvisionPlanEnvelope" }, "400": { "$ref": "#/components/responses/ErrorEnvelope" }, "403": { "$ref": "#/components/responses/ErrorEnvelope" }, "422": { "$ref": "#/components/responses/ProvisionErrorEnvelope" } } },
      "applyProvision": { "operationId": "applyProvision", "tags": ["Provisioning"], "summary": "Apply a spec to the served database.", "description": "Recomputes the plan and applies it as the calling principal (System:Admin and Database:Admin) when confirm is its current prov_ id; there is no client plan. 409 plan_changed when the id is no longer current, or object_conflict when a create met an existing object; 422 confirmation_required, flags_required, provision_blocked, invalid_spec, audit_required or rbac_self_lockout, with the plan or report in data; 500 provision_partially_applied with the report. Retunes and the storage format upgrade take effect at the next restart (session_pending_restart).", "security": [{ "BearerAuth": [] }], "x-multidb-stability": "preview", "requestBody": { "$ref": "#/components/requestBodies/ProvisionApplyRequest" }, "responses": { "200": { "$ref": "#/components/responses/ProvisionApplyReportEnvelope" }, "400": { "$ref": "#/components/responses/ErrorEnvelope" }, "403": { "$ref": "#/components/responses/ErrorEnvelope" }, "409": { "$ref": "#/components/responses/ProvisionErrorEnvelope" }, "422": { "$ref": "#/components/responses/ProvisionErrorEnvelope" }, "500": { "$ref": "#/components/responses/ProvisionErrorEnvelope" } } },
      "checkProvisionDrift": { "operationId": "checkProvisionDrift", "tags": ["Provisioning"], "summary": "Report how the served database differs from a spec.", "description": "The drift of the control_plane plan of the spec; 422 invalid_spec with the validation report in data for an invalid spec. Requires System:Admin.", "security": [{ "BearerAuth": [] }], "x-multidb-stability": "preview", "requestBody": { "$ref": "#/components/requestBodies/ProvisionRequest" }, "responses": { "200": { "$ref": "#/components/responses/DriftReportEnvelope" }, "400": { "$ref": "#/components/responses/ErrorEnvelope" }, "403": { "$ref": "#/components/responses/ErrorEnvelope" }, "422": { "$ref": "#/components/responses/ProvisionErrorEnvelope" } } },
      "getProfiles": { "operationId": "getProfiles", "tags": ["Admin"], "summary": "List built-in profiles.", "security": [{ "BearerAuth": [] }], "x-multidb-stability": "stable", "responses": { "200": { "$ref": "#/components/responses/JsonObjectEnvelope" } } },
      "getRoles": { "operationId": "getRoles", "tags": ["Admin"], "summary": "List collection roles.", "security": [{ "BearerAuth": [] }], "x-multidb-stability": "stable", "responses": { "200": { "$ref": "#/components/responses/JsonObjectEnvelope" } } },
      "getDomains": { "operationId": "getDomains", "tags": ["Admin"], "summary": "List consistency domains.", "security": [{ "BearerAuth": [] }], "x-multidb-stability": "stable", "responses": { "200": { "$ref": "#/components/responses/JsonObjectEnvelope" } } },
